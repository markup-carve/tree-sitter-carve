{
  "name": "tree-sitter-carve",
  "version": "0.1.1",
  "description": "Carve grammar for tree-sitter",
  "main": "bindings/node",
  "types": "bindings/node",
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "test:coverage": "node scripts/coverage-matrix.mjs",
    "test:conformance": "node scripts/corpus-conformance.mjs",
    "test:corpus": "node scripts/coverage-matrix.mjs && node scripts/corpus-conformance.mjs",
    "format": "prettier --write grammar.js",
    "check-formatted": "prettier --check grammar.js",
    "build-wasm": "tree-sitter build --wasm",
    "install": "node-gyp-build",
    "prebuildify": "prebuildify --napi --strip",
    "test:battery": "node scripts/block-battery.mjs",
    "test:battery-drift": "./tools/check-battery-drift.sh",
    "test:under-acceptance": "node scripts/under-acceptance.mjs",
    "test:no-error": "node scripts/no-error-sweep.mjs",
    "test:line-terminators": "node scripts/line-terminators.mjs"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "^7.1.0",
    "node-gyp-build": "^4.8.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.21.0"
  },
  "peerDependenciesMeta": {
    "tree_sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@markup-carve/carve": "git+https://github.com/markup-carve/carve-js.git#39b922385e84a2a05ab12fab60d23af37147df7b",
    "prebuildify": "^6.0.0",
    "prettier": "3.9.6",
    "tree-sitter-cli": "^0.22.1"
  },
  "files": [
    "grammar.js",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**"
  ],
  "tree-sitter": [
    {
      "scope": "text.carve",
      "injection-regex": "^carve$"
    }
  ]
}
