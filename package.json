{
  "name": "tree-sitter-carve",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markup-carve/tree-sitter-carve.git"
  },
  "homepage": "https://github.com/markup-carve/tree-sitter-carve#readme",
  "bugs": {
    "url": "https://github.com/markup-carve/tree-sitter-carve/issues"
  },
  "description": "Carve grammar for tree-sitter",
  "main": "bindings/node",
  "types": "bindings/node",
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test && node scripts/metadata-query.mjs",
    "test:parser-warnings": "node scripts/parser-warnings.mjs",
    "format": "prettier --write grammar.js",
    "check-formatted": "prettier --check grammar.js",
    "build-wasm": "tree-sitter build --wasm",
    "test:wasm": "node scripts/wasm-smoke.mjs",
    "install": "node-gyp-build",
    "prebuildify": "prebuildify --napi --strip",
    "test:final-terminator": "node scripts/final-terminator.mjs",
    "test:binding-parity": "node scripts/binding-parity.mjs",
    "test:marker-separators": "node scripts/marker-separators.mjs",
    "test:nesting-depth": "node scripts/nesting-depth.mjs",
    "test:asan": "node scripts/asan.mjs",
    "test:bracket-growth": "node scripts/bracket-growth.mjs",
    "test:version-surfaces": "node scripts/version-surfaces.mjs && node --test tests/version-surfaces.test.mjs",
    "test:editor-queries": "node scripts/editor-queries.mjs"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "^7.1.0",
    "node-gyp-build": "^4.8.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree_sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "prebuildify": "^6.0.0",
    "prettier": "3.9.6",
    "tree-sitter": "0.25.0",
    "tree-sitter-cli": "0.22.6",
    "web-tree-sitter-lowest": "npm:web-tree-sitter@0.22.6",
    "web-tree-sitter-newest": "npm:web-tree-sitter@0.27.0"
  },
  "files": [
    "grammar.js",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "tree-sitter-carve.wasm",
    "src/**"
  ],
  "tree-sitter": [
    {
      "scope": "text.carve",
      "injection-regex": "^carve$"
    }
  ]
}
